# サプライチェーン攻撃対策（Shai-Hulud/keyv系ワームなど、npmのpre/post installスクリプト経由で
# 任意コードを実行する攻撃への防御）。install時にスクリプトを一切自動実行しない。
# 正規のビルドに必要なスクリプトは package.json の lavamoat.allowScripts で明示許可したものだけ、
# `npm run setup`（= allow-scripts）で個別に実行する。
ignore-scripts=true

# package.json の ^ レンジで意図せず新しいバージョンが混入するのを防ぎ、
# `npm install <pkg>` のたびに正確なバージョンを package.json に固定する。
save-exact=true
