{
  "name": "tline",
  "version": "0.1.1",
  "description": "OuDia/OuDiaSecondのUI・機能を参考にした、運転整理（列車のn秒単位でのずらし）と実績記録を扱う運行管理補助デスクトップアプリ（計画・運転整理・実績の3タブ構成）",
  "private": true,
  "main": "main.js",
  "author": "_Illett_",
  "repository": {
    "type": "git",
    "url": "https://github.com/Illett0/TLINE.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "setup": "allow-scripts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@lavamoat/allow-scripts": "5.1.0",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "dev.illett.tline",
    "productName": "TLINE",
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json",
      "!node_modules/**/{test,tests,example,examples,*.md}",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TLINE",
      "menuCategory": false
    }
  },
  "lavamoat": {
    "allowScripts": {
      "electron-builder>app-builder-lib>electron-builder-squirrel-windows>electron-winstaller#5.4.0": true
    }
  }
}
